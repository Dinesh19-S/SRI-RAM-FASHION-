# Sri Ram Fashions Backend Environment Variables

# MongoDB Connection
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/sri-ram-fashions

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Port
PORT=5000

# Google Gemini AI API Key (FREE - Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
