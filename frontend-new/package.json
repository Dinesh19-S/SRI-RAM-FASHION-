{
  "name": "sri-ram-fashions",
  "productName": "Sri Ram Fashions",
  "version": "1.0.0",
  "private": true,
  "description": "Sri Ram Fashions Business Management Application",
  "author": "Sri Ram Fashions",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "electron:dev": "set ELECTRON_START_URL=http://localhost:5173 && electron .",
    "electron:build": "npm run build && electron-builder --win",
    "electron:package": "npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.sriramfashions.app",
    "productName": "Sri Ram Fashions",
    "directories": {
      "buildResources": "electron",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sri Ram Fashions"
    }
  },
  "dependencies": {
    "@react-oauth/google": "^0.12.2",
    "@reduxjs/toolkit": "^2.11.1",
    "@tailwindcss/vite": "^4.1.17",
    "axios": "^1.13.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.10.1",
    "recharts": "^3.5.1",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  }
}